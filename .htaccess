# --- HTTPS + 非wwwに統一 ---
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.arty-d\.com$ [NC]
RewriteRule ^ https://arty-d.com%{REQUEST_URI} [L,R=301]

# --- 旧WordPressの主要パスをトップページへ301リダイレクト ---
RewriteRule ^wp-(admin|content|includes|json)(/.*)?$ https://arty-d.com/ [L,R=301]
RewriteRule ^(feed|comments/feed|xmlrpc\.php)/?$ https://arty-d.com/ [L,R=301]

# --- 404は独自ページ(ステータスは404のまま) ---
ErrorDocument 404 /index.html

# --- 静的アセットのキャッシュ ---
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
</IfModule>
